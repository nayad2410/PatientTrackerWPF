<Window x:Class="PatientTrackerWPF.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="456" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Change Password" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" 
                   Text="Enter your current password and choose a new password:"
                   TextWrapping="Wrap" Margin="0,0,0,20" FontSize="12" Foreground="Gray"/>

        <Label Grid.Row="2" Content="Current Password:" FontWeight="Bold" Margin="0,0,0,5"/>
        <PasswordBox x:Name="CurrentPasswordBox" Grid.Row="3" Height="30" Margin="0,0,0,15"/>

        <Label Grid.Row="4" Content="New Password:" FontWeight="Bold" Margin="0,0,0,5"/>
        <PasswordBox x:Name="NewPasswordBox" Grid.Row="5" Height="30" Margin="0,0,0,15"/>

        <Label Grid.Row="6" Content="Confirm New Password:" FontWeight="Bold" Margin="0,0,0,5"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="7" Height="30" Margin="0,0,0,15"/>

        <TextBlock x:Name="StatusMessageText" Grid.Row="8" 
                   HorizontalAlignment="Center" Margin="0,10"
                   TextWrapping="Wrap" FontWeight="Bold"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" 
                    Margin="0,20,0,0">
            <Button x:Name="ChangePasswordBtn" Content="Change Password" Width="120" Height="35" 
                    Click="ChangePassword_Click" IsDefault="True" Margin="0,0,10,0"/>
            <Button x:Name="CancelBtn" Content="Cancel" Width="80" Height="35" 
                    Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>

        <Grid x:Name="LoadingGrid" Grid.RowSpan="9" Background="#80000000" 
              Visibility="Collapsed" Panel.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="0,0,0,10"/>
                <TextBlock Text="Changing password..." Foreground="White" 
                           HorizontalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>