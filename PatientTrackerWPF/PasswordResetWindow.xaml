<Window x:Class="PatientTrackerWPF.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Reset - Reconnect Progress Tracker" 
        MinHeight="500" MinWidth="550" Height="700" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#E6F3FF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Logo -->
        <Border Grid.Row="0" Background="#2B5F75" Padding="25">
            <StackPanel HorizontalAlignment="Center">
                <!-- Logo -->
                <Image Source="/Images/Logo_Reconnect1.png" 
                       Width="200" Height="50"
                       Stretch="Uniform" 
                       Margin="0 0 0 15"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderOptions.EdgeMode="Aliased"/>

                <TextBlock Text="Password Reset" 
                          FontSize="22" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center" Margin="0 15 0 0"/>
                <TextBlock Text="Reconnect Progress Tracker" 
                          FontSize="13" 
                          Foreground="LightGray" HorizontalAlignment="Center" Margin="0 8 0 0"/>
            </StackPanel>
        </Border>

        <!-- Reset Form -->
        <Border Grid.Row="1" Margin="25" Padding="30" Background="White" 
                BorderBrush="#2B5F75" BorderThickness="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Instructions -->
                    <TextBlock x:Name="InstructionsText" 
                              Text="Enter your email address to receive a password reset link:"
                              FontSize="15" FontWeight="SemiBold" 
                              Margin="0 0 0 30" TextWrapping="Wrap" Foreground="#2B5F75"/>

                    <!-- Initial Form (Email) -->
                    <StackPanel x:Name="InitialFormPanel">
                        <TextBlock Text="Email Address:" FontWeight="SemiBold" Margin="0 0 0 10" FontSize="15" Foreground="#2B5F75"/>
                        <TextBox x:Name="EmailTextBox" Height="45" FontSize="15" Padding="12"
                                BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 30"/>

                        <!-- MUCH LARGER send button -->
                        <Button x:Name="SendResetEmailBtn" Content="SEND RESET EMAIL" 
                                Height="60" Width="280" Margin="0 10 0 25"
                                Background="#2B5F75" Foreground="White" 
                                FontWeight="Bold" FontSize="16"
                                Click="SendResetEmail_Click" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="8" Padding="25,15">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1E4A5F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Reset Form (Token + Password) -->
                    <StackPanel x:Name="ResetFormPanel" Visibility="Collapsed">
                        <!-- Reset Token -->
                        <TextBlock Text="Reset Token:" FontWeight="SemiBold" Margin="0 0 0 10" FontSize="15" Foreground="#2B5F75"/>
                        <TextBox x:Name="ResetTokenTextBox" Height="45" FontSize="15" Padding="12"
                                BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 25"
                                ToolTip="Enter the reset token from your email"/>

                        <!-- New Password -->
                        <TextBlock Text="New Password:" FontWeight="SemiBold" Margin="0 0 0 10" FontSize="15" Foreground="#2B5F75"/>
                        <PasswordBox x:Name="NewPasswordBox" Height="45" FontSize="15" Padding="12"
                                    BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 25"
                                    ToolTip="At least 8 characters with uppercase, lowercase, number, and special character"/>

                        <!-- Confirm Password -->
                        <TextBlock Text="Confirm Password:" FontWeight="SemiBold" Margin="0 0 0 10" FontSize="15" Foreground="#2B5F75"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" Height="45" FontSize="15" Padding="12"
                                    BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 30"/>

                        <!-- Password Requirements -->
                        <Border Background="#FFFACD" BorderBrush="Orange" BorderThickness="1" 
                                Padding="20" Margin="0 0 0 25">
                            <TextBlock FontSize="13" TextWrapping="Wrap">
                                <Run Text="Password Requirements:" FontWeight="Bold"/>
                                <LineBreak/>
                                <Run Text="• At least 8 characters long"/>
                                <LineBreak/>
                                <Run Text="• Contains uppercase and lowercase letters"/>
                                <LineBreak/>
                                <Run Text="• Contains at least one number"/>
                                <LineBreak/>
                                <Run Text="• Contains at least one special character (!@#$%^&amp;*)"/>
                            </TextBlock>
                        </Border>

                        <!-- MUCH LARGER reset password button -->
                        <Button x:Name="ResetPasswordBtn" Content="RESET PASSWORD" 
                                Height="60" Width="280" Margin="0 30 0 20"
                                Background="Green" Foreground="White" 
                                FontWeight="Bold" FontSize="16"
                                Click="ResetPassword_Click" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="8" Padding="25,15">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="DarkGreen"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- LARGER back button -->
                        <Button x:Name="BackToEmailBtn" Content="← Back to Email Entry" 
                               Background="Transparent" BorderThickness="2" BorderBrush="#2B5F75"
                               Foreground="#2B5F75" FontWeight="SemiBold" FontSize="14"
                               Click="BackToEmail_Click" Cursor="Hand" 
                               Height="50" Width="220" 
                               HorizontalAlignment="Center" Margin="0 15 0 0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="2"
                                                        CornerRadius="6" 
                                                        Padding="20,12">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E6F3FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Status Message -->
                    <TextBlock x:Name="StatusMessageText" Text="" Margin="0 25 0 25" 
                              TextWrapping="Wrap" HorizontalAlignment="Center"
                              Foreground="Red" FontWeight="SemiBold" FontSize="14"/>

                    <!-- LARGER cancel button -->
                    <Button x:Name="CancelBtn" Content="✕ Cancel" 
                           Background="Gray" Foreground="White" 
                           FontWeight="SemiBold" FontSize="14"
                           Click="Cancel_Click" Cursor="Hand" 
                           Height="50" Width="150"
                           HorizontalAlignment="Center" Margin="0 20 0 0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="6" 
                                                    Padding="20,12">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="DarkGray"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2B5F75" Padding="15">
            <TextBlock Text="Secure Password Reset System v1.0" 
                      FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingGrid" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" Width="320" Height="160" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="240" Height="20" Margin="0 0 0 25"/>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" 
                              FontWeight="SemiBold" FontSize="16" Foreground="#2B5F75"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>