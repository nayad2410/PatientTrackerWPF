<Window x:Class="PatientTrackerWPF.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Reset - Reconnect Progress Tracker" 
        MinHeight="400" MinWidth="450" Height="550" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#E6F3FF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Logo -->
        <Border Grid.Row="0" Background="#2B5F75" Padding="20">
            <StackPanel HorizontalAlignment="Center">
                <!-- Logo -->
                <Image Source="/Images/Logo_Reconnect1.png" 
                       Width="180" Height="45"
                       Stretch="Uniform" 
                       Margin="0 0 0 10"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderOptions.EdgeMode="Aliased"/>

                <TextBlock Text="Password Reset" 
                          FontSize="20" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center" Margin="0 10 0 0"/>
                <TextBlock Text="Reconnect Progress Tracker" 
                          FontSize="12" 
                          Foreground="LightGray" HorizontalAlignment="Center" Margin="0 5 0 0"/>
            </StackPanel>
        </Border>

        <!-- Reset Form -->
        <Border Grid.Row="1" Margin="20" Padding="20" Background="White" 
                BorderBrush="#2B5F75" BorderThickness="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Instructions -->
                    <TextBlock x:Name="InstructionsText" 
                              Text="Enter your email address to receive a password reset link:"
                              FontSize="14" FontWeight="SemiBold" 
                              Margin="0 0 0 20" TextWrapping="Wrap" Foreground="#2B5F75"/>

                    <!-- Initial Form (Email) -->
                    <StackPanel x:Name="InitialFormPanel">
                        <TextBlock Text="Email Address:" FontWeight="SemiBold" Margin="0 0 0 5" FontSize="14" Foreground="#2B5F75"/>
                        <TextBox x:Name="EmailTextBox" Height="35" FontSize="14" Padding="8"
                                BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 20"/>

                        <Button x:Name="SendResetEmailBtn" Content="SEND RESET EMAIL" Height="45" Margin="0 0 0 15"
                                Background="#2B5F75" Foreground="White" FontWeight="Bold" FontSize="16"
                                Click="SendResetEmail_Click" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1E4A5F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Reset Form (Token + Password) -->
                    <StackPanel x:Name="ResetFormPanel" Visibility="Collapsed">
                        <!-- Reset Token -->
                        <TextBlock Text="Reset Token:" FontWeight="SemiBold" Margin="0 0 0 5" FontSize="14" Foreground="#2B5F75"/>
                        <TextBox x:Name="ResetTokenTextBox" Height="35" FontSize="14" Padding="8"
                                BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 15"
                                ToolTip="Enter the reset token from your email"/>

                        <!-- New Password -->
                        <TextBlock Text="New Password:" FontWeight="SemiBold" Margin="0 0 0 5" FontSize="14" Foreground="#2B5F75"/>
                        <PasswordBox x:Name="NewPasswordBox" Height="35" FontSize="14" Padding="8"
                                    BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 15"
                                    ToolTip="At least 8 characters with uppercase, lowercase, number, and special character"/>

                        <!-- Confirm Password -->
                        <TextBlock Text="Confirm Password:" FontWeight="SemiBold" Margin="0 0 0 5" FontSize="14" Foreground="#2B5F75"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" Height="35" FontSize="14" Padding="8"
                                    BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 20"/>

                        <!-- Password Requirements -->
                        <Border Background="#FFFACD" BorderBrush="Orange" BorderThickness="1" 
                                Padding="10" Margin="0 0 0 15">
                            <TextBlock FontSize="12" TextWrapping="Wrap">
                                <Run Text="Password Requirements:" FontWeight="Bold"/>
                                <LineBreak/>
                                <Run Text="• At least 8 characters long"/>
                                <LineBreak/>
                                <Run Text="• Contains uppercase and lowercase letters"/>
                                <LineBreak/>
                                <Run Text="• Contains at least one number"/>
                                <LineBreak/>
                                <Run Text="• Contains at least one special character (!@#$%^&amp;*)"/>
                            </TextBlock>
                        </Border>

                        <Button x:Name="ResetPasswordBtn" Content="RESET PASSWORD" Height="45" Margin="0 20 0 10"
                                Background="Green" Foreground="White" FontWeight="Bold" FontSize="16"
                                Click="ResetPassword_Click" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="DarkGreen"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="BackToEmailBtn" Content="Back to Email Entry" 
                               Background="Transparent" BorderThickness="1" BorderBrush="Gray"
                               Foreground="Gray" FontWeight="SemiBold" FontSize="12"
                               Click="BackToEmail_Click" Cursor="Hand" Height="30"
                               HorizontalAlignment="Center" Margin="0 5 0 0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="LightGray"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Status Message -->
                    <TextBlock x:Name="StatusMessageText" Text="" Margin="0 15 0 15" 
                              TextWrapping="Wrap" HorizontalAlignment="Center"
                              Foreground="Red" FontWeight="SemiBold" FontSize="12"/>

                    <!-- Cancel Button -->
                    <Button x:Name="CancelBtn" Content="Cancel" 
                           Background="Gray" Foreground="White" FontWeight="SemiBold" FontSize="13"
                           Click="Cancel_Click" Cursor="Hand" Height="35" Width="100"
                           HorizontalAlignment="Center" Margin="0 10 0 0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="3" Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="DarkGray"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2B5F75" Padding="10">
            <TextBlock Text="Secure Password Reset System v1.0" 
                      FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingGrid" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" Width="250" Height="120" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="15" Margin="0 0 0 15"/>
                    <TextBlock Text="Processing..." HorizontalAlignment="Center" 
                              FontWeight="SemiBold" FontSize="14" Foreground="#2B5F75"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>