<Window x:Class="PatientTrackerWPF.loginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PatientTrackerWPF"
        mc:Ignorable="d"
        Title="loginWindow" Height="450" Width="800">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="DarkBlue" Padding="20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Patient Tracker System" 
                          FontSize="20" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Secure Login Required" 
                          FontSize="12" 
                          Foreground="LightGray" HorizontalAlignment="Center" Margin="0 5 0 0"/>
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <Border Grid.Row="1" Margin="40" Padding="30" Background="White" 
                BorderBrush="Gray" BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Please Sign In" FontSize="16" FontWeight="Bold" 
                          HorizontalAlignment="Center" Margin="0 0 0 20"/>

                <!-- Username -->
                <TextBlock Text="Username:" FontWeight="SemiBold" Margin="0 0 0 5"/>
                <TextBox x:Name="UsernameBox" Height="30" FontSize="14" Padding="5"
                         BorderBrush="DarkBlue" BorderThickness="2"/>

                <!-- Password -->
                <TextBlock Text="Password:" FontWeight="SemiBold" Margin="0 15 0 5"/>
                <PasswordBox x:Name="PasswordBox" Height="30" FontSize="14" Padding="5"
                            BorderBrush="DarkBlue" BorderThickness="2"/>

                <!-- Remember Me -->
                <CheckBox x:Name="RememberMeCheck" Content="Remember me" Margin="0 15 0 0"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton" Content="Sign In" Height="40" Margin="0 20 0 0"
                        Background="DarkBlue" Foreground="White" FontWeight="Bold" FontSize="14"
                        Click="LoginButton_Click"/>

                <!-- Status Message -->
                <TextBlock x:Name="StatusMessage" Text="" Margin="0 15 0 0" 
                          TextWrapping="Wrap" HorizontalAlignment="Center"
                          Foreground="Red" FontWeight="SemiBold"/>

                <!-- Links -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 15 0 0">
                    <Button x:Name="ForgotPasswordButton" Content="Forgot Password?" 
                           Background="Transparent" BorderThickness="0" 
                           Foreground="DarkBlue" FontWeight="SemiBold"
                           Click="ForgotPasswordButton_Click" Cursor="Hand"/>
                    <TextBlock Text=" | " Margin="5 0"/>
                    <Button x:Name="CreateAccountButton" Content="Create Account" 
                           Background="Transparent" BorderThickness="0" 
                           Foreground="DarkBlue" FontWeight="SemiBold"
                           Click="CreateAccountButton_Click" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="DarkGray" Padding="10">
            <TextBlock Text="Mental Health Patient Tracking System v1.0" 
                      FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" Width="200" Height="100" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="150" Height="10" Margin="0 0 0 10"/>
                    <TextBlock Text="Authenticating..." HorizontalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
