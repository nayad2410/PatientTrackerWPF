<Window x:Class="PatientTrackerWPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reconnect Progress Tracker - Login" 
        MinHeight="650" MinWidth="350" Height="750" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#E6F3FF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Logo -->
        <Border Grid.Row="0" Background="#2B5F75" Padding="20">
            <StackPanel HorizontalAlignment="Center">
                <!-- Logo -->
                <Image Source="/Images/Logo_Reconnect1.png" 
                       Width="200" Height="50"
                       Stretch="Uniform" 
                       Margin="0 0 0 10"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderOptions.EdgeMode="Aliased"/>

                <TextBlock Text="Progress Tracker" 
                          FontSize="20" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0 10 0 0"/>
                <TextBlock Text="Secure Login Required" 
                          FontSize="12" 
                          Foreground="LightGray" HorizontalAlignment="Center" Margin="0 5 0 0"/>
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <Border Grid.Row="1" Margin="20" Padding="20" Background="White" 
                BorderBrush="#2B5F75" BorderThickness="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Please Sign In" FontSize="18" FontWeight="Bold" 
                              HorizontalAlignment="Center" Margin="0 0 0 25" Foreground="#2B5F75"/>

                    <!-- Username -->
                    <TextBlock Text="Username:" FontWeight="SemiBold" Margin="0 0 0 5" FontSize="14" Foreground="#2B5F75"/>
                    <TextBox x:Name="UsernameTextBox" Height="35" FontSize="14" Padding="8"
                             BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 15"/>

                    <!-- Password -->
                    <TextBlock Text="Password:" FontWeight="SemiBold" Margin="0 0 0 5" FontSize="14" Foreground="#2B5F75"/>
                    <PasswordBox x:Name="PasswordTextBox" Height="35" FontSize="14" Padding="8"
                                BorderBrush="#2B5F75" BorderThickness="2" Margin="0 0 0 15"/>

                    <!-- Remember Me -->
                    <CheckBox x:Name="RememberMeCheckBox" Content="Remember me" Margin="0 5 0 20" FontSize="13" Foreground="#2B5F75"/>

                    <!-- Login Button -->
                    <Button x:Name="LoginBtn" Content="SIGN IN" Height="45" Margin="0 0 0 15"
                            Background="#2B5F75" Foreground="White" FontWeight="Bold" FontSize="16"
                            Click="LoginBtn_Click" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5" Padding="10">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1E4A5F"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Status Message -->
                    <TextBlock x:Name="StatusMessageText" Text="" Margin="0 15 0 15" 
                              TextWrapping="Wrap" HorizontalAlignment="Center"
                              Foreground="Red" FontWeight="SemiBold" FontSize="12"/>

                    <!-- Links -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0 10 0 0">
                        <Button x:Name="ForgotPasswordBtn" Content="Forgot Password?" 
                               Background="Transparent" BorderThickness="0" 
                               Foreground="#2B5F75" FontWeight="SemiBold" FontSize="13"
                               Click="ForgotPasswordBtn_Click" Cursor="Hand" Margin="0 0 0 8"
                               HorizontalAlignment="Center" Padding="5">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" Padding="5">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#1E4A5F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="CreateAccountBtn" Content="Create New Account" 
                               Background="LightGreen" BorderThickness="1" BorderBrush="Green"
                               Foreground="DarkGreen" FontWeight="SemiBold" FontSize="13"
                               Click="CreateAccountBtn_Click" Cursor="Hand" Height="35"
                               MinWidth="180" MaxWidth="250"
                               HorizontalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3" Padding="10,8">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="PaleGreen"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#2B5F75" Padding="10">
            <TextBlock Text="Mental Health Patient Tracking System v1.0" 
                      FontSize="10" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingGrid" Visibility="Collapsed" Background="#80000000">
            <Border Background="White" Width="250" Height="120" CornerRadius="10"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="15" Margin="0 0 0 15"/>
                    <TextBlock Text="Authenticating..." HorizontalAlignment="Center" 
                              FontWeight="SemiBold" FontSize="14" Foreground="#2B5F75"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>