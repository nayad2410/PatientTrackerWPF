                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="Gray"
                                       LineHeight="16"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3: Treatment Notes -->
