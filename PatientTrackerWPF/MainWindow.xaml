                                </StackPanel>
                            </Border>

                            <!-- Note Box 2 -->
                            <Border x:Name="NoteBox2" 
                                Canvas.Left="250" 
                                Canvas.Top="80"
                                Background="#E6F3FF" 
                                BorderBrush="#DDD" 
                                BorderThickness="1" 
                                CornerRadius="3"
                                Padding="8,4"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="NoteBox_MouseLeftButtonUp"
                                Cursor="Hand"
                                IsHitTestVisible="True"
                                Width="140"
                                Height="50">
                                <StackPanel>
                                    <TextBlock x:Name="NoteTitle2" 
                                          Text="Medication Change" 
                                          FontWeight="Bold" 
                                          FontSize="10"/>
                                    <TextBlock x:Name="NoteText2" 
                                          Text="Dosage adjusted"
                                          FontSize="9" 
                                          Foreground="DarkGray"
                                          TextWrapping="Wrap"
                                          TextTrimming="CharacterEllipsis"
                                          MaxHeight="30"/>
                                </StackPanel>
                            </Border>

                            <!-- Note Box 3 -->
                            <Border x:Name="NoteBox3" 
                                Canvas.Left="450" 
                                Canvas.Top="50"
                                Background="#F0F8E6" 
                                BorderBrush="#DDD" 
                                BorderThickness="1" 
                                CornerRadius="3"
                                Padding="8,4"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="NoteBox_MouseLeftButtonUp"
                                Cursor="Hand"
                                IsHitTestVisible="True"
                                Width="140"
                                Height="50">
                                <StackPanel>
                                    <TextBlock x:Name="NoteTitle3" 
                                          Text="Therapy Session" 
                                          FontWeight="Bold" 
                                          FontSize="10"/>
                                    <TextBlock x:Name="NoteText3" 
                                          Text="CBT intervention"
                                          FontSize="9" 
                                          Foreground="DarkGray"
                                          TextWrapping="Wrap"
                                          TextTrimming="CharacterEllipsis"
                                          MaxHeight="30"/>
                                </StackPanel>
                            </Border>

                            <!-- Additional Note Boxes for more notes -->
                            <Border x:Name="NoteBox4" 
                                Canvas.Left="80" 
                                Canvas.Top="150"
                                Background="#FFE6E6" 
                                BorderBrush="#DDD" 
                                BorderThickness="1" 
                                CornerRadius="3"
                                Padding="8,4"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="NoteBox_MouseLeftButtonUp"
                                Cursor="Hand"
                                IsHitTestVisible="True"
                                Width="140"
                                Height="50">
                                <StackPanel>
                                    <TextBlock x:Name="NoteTitle4" 
                                          Text="Follow-up" 
                                          FontWeight="Bold" 
                                          FontSize="10"/>
                                    <TextBlock x:Name="NoteText4" 
                                          Text="Progress review"
                                          FontSize="9" 
                                          Foreground="DarkGray"
                                          TextWrapping="Wrap"
                                          TextTrimming="CharacterEllipsis"
                                          MaxHeight="30"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="NoteBox5" 
                                Canvas.Left="320" 
                                Canvas.Top="180"
                                Background="#E6FFE6" 
                                BorderBrush="#DDD" 
                                BorderThickness="1" 
                                CornerRadius="3"
                                Padding="8,4"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="NoteBox_MouseLeftButtonUp"
                                Cursor="Hand"
                                IsHitTestVisible="True"
                                Width="140"
                                Height="50">
                                <StackPanel>
                                    <TextBlock x:Name="NoteTitle5" 
                                          Text="Milestone" 
                                          FontWeight="Bold" 
                                          FontSize="10"/>
                                    <TextBlock x:Name="NoteText5" 
                                          Text="Significant improvement"
                                          FontSize="9" 
                                          Foreground="DarkGray"
                                          TextWrapping="Wrap"
                                          TextTrimming="CharacterEllipsis"
                                          MaxHeight="30"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="NoteBox6" 
                                Canvas.Left="500" 
                                Canvas.Top="140"
                                Background="#F0E6FF" 
                                BorderBrush="#DDD" 
                                BorderThickness="1" 
                                CornerRadius="3"
                                Padding="8,4"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="NoteBox_MouseLeftButtonUp"
                                Cursor="Hand"
                                IsHitTestVisible="True"
                                Width="140"
                                Height="50">
                                <StackPanel>
                                    <TextBlock x:Name="NoteTitle6" 
                                          Text="Assessment" 
                                          FontWeight="Bold" 
                                          FontSize="10"/>
                                    <TextBlock x:Name="NoteText6" 
                                          Text="Regular check-in"
                                          FontSize="9" 
                                          Foreground="DarkGray"
                                          TextWrapping="Wrap"
                                          TextTrimming="CharacterEllipsis"
                                          MaxHeight="30"/>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- 6: Data Grid - FIXED HEIGHT with scrolling -->
                <Border Grid.Row="6" 
                    BorderBrush="#2B5F75"
                    BorderThickness="2"
                    Background="White"
                    Margin="0,5">
                    <DataGrid x:Name="ScoresGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          AlternatingRowBackground="#F0F8FF"
                          ColumnHeaderHeight="35"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          Background="White"
                              IsReadOnly="True"
                              CanUserResizeRows="False"
                          MouseDoubleClick="ScoresGrid_MouseDoubleClick_1"
                          SelectionChanged="ScoresGrid_SelectionChanged"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="35"/>
                                <Setter Property="Height" Value="Auto"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#2B5F75"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Patient ID"
                                            Binding="{Binding PatientId}"
                                            Width="120" MinWidth="80"
                                            ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Date"
                                            Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"
                                            Width="120" MinWidth="80"
                                            ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="PHQ-9"
                                            Binding="{Binding PHQ9, Converter={StaticResource ScoreConverter}}"
                                            Width="80" MinWidth="50"
                                            ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="GAD-7"
                                            Binding="{Binding GAD7, Converter={StaticResource ScoreConverter}}"
                                            Width="80" MinWidth="50"
                                            ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="BDI-II"
                                            Binding="{Binding BDI2, Converter={StaticResource ScoreConverter}}"
                                            Width="80" MinWidth="50"
                                            ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="PCL-5"
                                            Binding="{Binding PCL5, Converter={StaticResource ScoreConverter}}"
                                            Width="80" MinWidth="50"
                                            ElementStyle="{StaticResource CenteredCellStyle}"/>
                            <DataGridTextColumn Header="Y-BOCS"
                                            Binding="{Binding YBOCS, Converter={StaticResource ScoreConverter}}"
                                            Width="80" MinWidth="50"
                                            ElementStyle="{StaticResource CenteredCellStyle}"/>

                            <DataGridTextColumn Header="Treatment Notes"
                                            Binding="{Binding Note}"
                                            Width="*" MinWidth="300">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Padding" Value="8"/>
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Setter Property="LineHeight" Value="16"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </ScrollViewer>


        <!-- Export Layout Panel - FIXED CONFIGURATION -->
        <Border x:Name="ExportLayout"
        Visibility="Collapsed"
        Background="White"
        BorderBrush="#CCCCCC"
        BorderThickness="1"
        Padding="20"
        Margin="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Panel.ZIndex="100">

            <!-- FIXED: Use StackPanel with no height constraints -->
            <StackPanel x:Name="ExportContent" 
                Width="900" 
                Orientation="Vertical">

                <!-- Export Header with Logo -->
                <Border Background="{StaticResource PrimaryBrush}" 
                Padding="15" 
                Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo -->
                        <Image Source="/Images/Logo_Reconnect1.png"
                       Width="150" Height="40"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderOptions.EdgeMode="Aliased"
                       Margin="0,0,20,0"/>

                        <!-- Header Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Patient Progress Report"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mental Health Assessment Report"
                               FontSize="14" Foreground="LightGray"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Patient Info -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock x:Name="ExportPatientId" 
