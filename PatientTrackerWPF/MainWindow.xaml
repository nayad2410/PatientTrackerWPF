                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Clinical Progress Summary" FontWeight="Bold" FontSize="12"
                                       Foreground="#2B5F75" Margin="0,0,0,5"/>
