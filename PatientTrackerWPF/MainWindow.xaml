<Window x:Class="PatientTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Patient Score Entry" Height="850" Width="1000">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Patient Selector -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Select Patient:" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <ComboBox x:Name="PatientSelector" Width="150" SelectionChanged="PatientSelector_SelectionChanged"/>
        </StackPanel>

        <!-- Input Fields -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0 0 0 10">
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="Patient ID"/>
                <TextBox x:Name="PatientIdBox" Width="100"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="PHQ-9"/>
                <TextBox x:Name="Phq9Box" Width="60"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="GAD-7"/>
                <TextBox x:Name="Gad7Box" Width="60"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="BDI-II"/>
                <TextBox x:Name="Bdi2Box" Width="60"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="PCL-5"/>
                <TextBox x:Name="PCL5Total" Width="60"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="YBOCS"/>
                <TextBox x:Name="YBOCS" Width="60"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="Date"/>
                <DatePicker x:Name="DatePicker" SelectedDate="{x:Static sys:DateTime.Now}" Width="120"/>
            </StackPanel>
            <Button Content="Add Score" Click="AddScore_Click" Margin="10 0"/>
        </StackPanel>

        <!-- Note Box -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0 0 0 10">
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="Note"/>
                <TextBox x:Name="NoteBox" Width="600" Height="40" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <!-- Chart -->
        <lvc:CartesianChart Grid.Row="3"
                            Name="progressChart"
                            Series="{Binding ScoreSeriesCollection}"
                            Height="250"
                            VerticalAlignment="Top"
                            Margin="0 10">
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="Score" MinValue="0" MaxValue="100">
                    <lvc:Axis.Separator>
                        <lvc:Separator Step="10"/>
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

        <!-- Filter + Export -->
        <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0 10">
            <TextBlock Text="Filter by Patient ID:" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <TextBox x:Name="FilterBox" Width="100" Margin="0 0 10 0" TextChanged="FilterBox_TextChanged"/>
            <Button Content="Export to CSV" Click="ExportToCsv_Click"/>
            <Button Content="Export to PNG" Click="ExportToPng_Click" Margin="10 0"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid x:Name="ScoresGrid"
                  Grid.Row="5"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  TextOptions.TextFormattingMode="Display">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PatientId" Binding="{Binding PatientId}" Width="SizeToHeader"/>
                <DataGridTextColumn Header="PHQ9" Binding="{Binding PHQ9}" Width="60"/>
                <DataGridTextColumn Header="GAD7" Binding="{Binding GAD7}" Width="60"/>
                <DataGridTextColumn Header="PCL5" Binding="{Binding PCL5}" Width="60"/>
                <DataGridTextColumn Header="BDI2" Binding="{Binding BDI2}" Width="60"/>
                <DataGridTextColumn Header="PCL5Total" Binding="{Binding PCL5Total}" Width="60"/>
                <DataGridTextColumn Header="YBOCS" Binding="{Binding YBOCS}" Width="60"/>
                <DataGridTemplateColumn Header="Note" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Padding="5" MaxWidth="1000"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="180"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Export Layout (Hidden) -->
        <Grid x:Name="ExportLayout" Visibility="Collapsed" Background="White">
            <Border Padding="40" Background="White">
                <StackPanel Width="2200" Orientation="Vertical" >

                    <!-- Header -->
                    <TextBlock Text="Patient Report" FontSize="28" FontWeight="Bold" Margin="0 0 0 20"/>
                    <TextBlock x:Name="ExportPatientId" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="ExportDate" FontSize="14" Margin="0 0 0 20"/>

                    <!-- Data Table -->
                    <DataGrid x:Name="ExportScoreGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      Margin="0 0 0 20"
                      FontSize="14"
                      ColumnHeaderHeight="32"
                    >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PatientId" Binding="{Binding PatientId}" Width="80"/>
                            <DataGridTextColumn Header="PHQ9" Binding="{Binding PHQ9}" Width="60"/>
                            <DataGridTextColumn Header="GAD7" Binding="{Binding GAD7}" Width="60"/>
                            <DataGridTextColumn Header="PCL5" Binding="{Binding PCL5}" Width="60"/>
                            <DataGridTextColumn Header="BDI2" Binding="{Binding BDI2}" Width="60"/>
                            <DataGridTextColumn Header="PCL5Total" Binding="{Binding PCL5Total}" Width="80"/>
                            <DataGridTextColumn Header="YBOCS" Binding="{Binding YBOCS}" Width="60"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Chart -->
                    <Image x:Name="ExportChartImage"
       Height="300"
       Width="2200"
       HorizontalAlignment="Left"
       Stretch="None"
       Margin="0 0 0 20"/>



                    <!-- Notes -->
                    <TextBlock Text="Treatment Notes:" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
                    <TextBlock x:Name="ExportNoteText"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Width="1800"
                       Margin="0 0 0 20"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
