<Window x:Class="PatientTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:PatientTrackerWPF"
        mc:Ignorable="d"
        Title="Reconnect Progress Tracker"
        Height="1000" Width="1400"
        MinHeight="600" MinWidth="800"
        Background="#E6F3FF">

    <Window.Resources>
        <!-- Score converter and tooltip -->
        <local:ScoreConverter x:Key="ScoreConverter"/>
        <lvc:DefaultTooltip x:Key="MyTooltip"
                            SelectionMode="OnlySender"
                            Background="White"
                            BorderBrush="#2B5F75"
                            BorderThickness="2"
                            CornerRadius="5"/>
        <!-- Brand colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2B5F75"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#E6F3FF"/>
        <SolidColorBrush x:Key="AccentBrush"   Color="#F0F8FF"/>
        <!-- Report constants -->
        <sys:Double x:Key="ReportWidth">900</sys:Double>
        <sys:Int32 x:Key="ReportDpi">300</sys:Int32>
        <!-- Centered cell style -->
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
        <!-- Column widths for the history table -->
        <x:Array x:Key="HistoryColumnWidths" Type="{x:Type sys:Double}">
            <sys:Double>100</sys:Double>
            <sys:Double>100</sys:Double>
            <sys:Double>80</sys:Double>
            <sys:Double>80</sys:Double>
            <sys:Double>80</sys:Double>
            <sys:Double>80</sys:Double>
            <sys:Double>80</sys:Double>
            <sys:Double>300</sys:Double>
        </x:Array>
    </Window.Resources>

    <Grid>
        <!-- Main application layout wrapped in ScrollViewer -->
        <ScrollViewer x:Name="MainScrollViewer" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="MainGrid" Margin="10" MinWidth="800">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 0: Logo/Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1: Patient Selector -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2: Input Fields + Filter + Export Controls -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3: Treatment Notes -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4: Collapsible Clinical Metrics - MINIMAL when collapsed -->
                    <RowDefinition Height="450" MinHeight="400"/>
                    <!-- 5: Chart + Notes - FIXED HEIGHT -->
                    <RowDefinition Height="300" MinHeight="250"/>
                    <!-- 6: Data Grid - FIXED HEIGHT -->
                </Grid.RowDefinitions>

                <!-- 0: Logo/Header -->
                <!-- 0: Logo/Header with Logout Button -->
                <Border Grid.Row="0" Background="#2B5F75" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#2B5F75" Height="60" Margin="0,0,20,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Images/Logo_Reconnect1.png"
       Width="200" Height="50"
       Stretch="Uniform"
       RenderOptions.BitmapScalingMode="HighQuality"
       RenderOptions.EdgeMode="Aliased"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Reconnect Progress Tracker"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mental Health Assessment and Progress Monitoring System"
                                   FontSize="12" Foreground="LightGray"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>


                        <!-- Updated User Info with Logout Button -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                                <StackPanel Margin="0,0,15,0">
                                    <TextBlock Text="Current User:" FontSize="10" Foreground="LightGray"/>
                                    <TextBlock x:Name="CurrentUserText" Text="System User"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="White"/>
                                </StackPanel>

                                <!-- Logout Button -->
                                <Button x:Name="LogoutButton" 
                                        Content="Logout"
                                        Click="LogoutButton_Click"
                                        Width="70" Height="25"
                                        Background="#C0392B" Foreground="White"
                                        FontWeight="Bold" FontSize="10"
                                        BorderThickness="0" Cursor="Hand"
                                        VerticalAlignment="Top">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="3"
                                                                Padding="8,3">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#A93226"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- User Role Display -->
                            <TextBlock x:Name="UserRoleText" 
                                       Text="Administrator"
                                       FontSize="9" 
                                       Foreground="LightGray"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

           

                <!-- 1: Patient Selector -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Select Patient:" VerticalAlignment="Center"
                           Margin="0,0,10,0" FontWeight="Bold" Foreground="#2B5F75"/>
                    <ComboBox x:Name="PatientSelector"
                          Width="200"
                          BorderBrush="#2B5F75"
                          BorderThickness="2"
                          SelectionChanged="PatientSelector_SelectionChanged"/>
                </StackPanel>

                <!-- 2: Input Fields + Filter + Export Controls -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Left: Input fields -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Center: Filter and Export buttons -->
                        <ColumnDefinition Width="*"/>
                        <!-- Spacer -->
                    </Grid.ColumnDefinitions>

                    <!-- Left Side: Input Fields and Add Score Button -->
                    <StackPanel x:Name="InputFieldsPanel"
                            Grid.Column="0"
                            Orientation="Horizontal">
                        <!-- Patient ID -->
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Patient ID" FontWeight="SemiBold" Foreground="#2B5F75"/>
                            <TextBox x:Name="PatientIdBox" Width="100" Height="25"
                                 BorderBrush="#2B5F75" BorderThickness="2"/>
                        </StackPanel>
                        <!-- PHQ-9 -->
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="PHQ-9" FontWeight="SemiBold" Foreground="#2B5F75"/>
                            <TextBox x:Name="Phq9Box" Width="60" Height="25"
                                 BorderBrush="#2B5F75" BorderThickness="2"/>
                        </StackPanel>
                        <!-- GAD-7 -->
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="GAD-7" FontWeight="SemiBold" Foreground="#2B5F75"/>
                            <TextBox x:Name="Gad7Box" Width="60" Height="25"
                                 BorderBrush="#2B5F75" BorderThickness="2"/>
                        </StackPanel>
                        <!-- BDI-II -->
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="BDI-II" FontWeight="SemiBold" Foreground="#2B5F75"/>
                            <TextBox x:Name="Bdi2Box" Width="60" Height="25"
                                 BorderBrush="#2B5F75" BorderThickness="2"/>
                        </StackPanel>
                        <!-- PCL-5 -->
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="PCL-5" FontWeight="SemiBold" Foreground="#2B5F75"/>
                            <TextBox x:Name="PCL5Total" Width="60" Height="25"
                                 BorderBrush="#2B5F75" BorderThickness="2"/>
                        </StackPanel>
                        <!-- Y-BOCS -->
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Y-BOCS" FontWeight="SemiBold" Foreground="#2B5F75"/>
                            <TextBox x:Name="YBOCS" Width="60" Height="25"
                                 BorderBrush="#2B5F75" BorderThickness="2"/>
                        </StackPanel>
                        <!-- Date -->
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Date" FontWeight="SemiBold" Foreground="#2B5F75"/>
                            <DatePicker x:Name="DatePicker"
                                    SelectedDate="{x:Static sys:DateTime.Now}"
                                    Width="120" Height="25"
                                    BorderBrush="#2B5F75" BorderThickness="2"/>
                        </StackPanel>
                        <!-- Add Score Button -->
                        <Button x:Name="AddScoreButton"
        Content="Add Score"
        Click="AddScore_Click"
                            Margin="10,15,0,0"
                            Width="auto" MinWidth="100" Height="30"
                            Background="#2B5F75" Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="8">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1E4A5F"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Right Side: Filter and Export Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <!-- Filter Section -->
                        <StackPanel Orientation="Horizontal" Margin="0,15,10,0">
                            <TextBlock Text="Filter:" VerticalAlignment="Center"
                   Margin="0,0,5,0" FontWeight="SemiBold" Foreground="#2B5F75"/>
                            <TextBox x:Name="FilterBox"
                 Width="100" Height="25"
                 BorderBrush="#2B5F75" BorderThickness="2"
                 TextChanged="FilterBox_TextChanged"/>
                        </StackPanel>

                        <!-- Admin Controls Group -->
                        <StackPanel Orientation="Horizontal" Margin="5,0">
                            <!-- Admin-Only Buttons - Compact Size -->
                            <Button x:Name="BackupNowButton"
                Content="💾 Backup"
                Width="85" Height="30"
                Margin="3"
                Click="BackupNowButton_Click"
                Visibility="Collapsed"
                Background="#2B5F75" Foreground="White"
                FontWeight="Bold" FontSize="9"
                BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="6,4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1E4A5F"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                           

                           
                            <Button x:Name="UserManagementButton"
        Content="👥 Users"
        Width="85" Height="30"
        Margin="3"
        Click="UserManagement_Click"
        Visibility="Collapsed"
        Background="#2B5F75" Foreground="White"
        FontWeight="Bold" FontSize="9"
        BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="6,4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1E4A5F"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="ImportCsvButton"
                Content="📁 Import"
                Width="85" Height="30"
                Margin="3"
                Click="ImportCsvButton_Click"
                Visibility="Collapsed" 
                Background="DarkOrange" Foreground="White"
                FontWeight="Bold" FontSize="9"
                BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="6,4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#CC7A00"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="DeletePatientButton"
                Content="🗑️ Delete"
                Width="85" Height="30"
                Margin="3,10,0,0"
                Click="DeletePatient_Click"
                Visibility="Collapsed"
                Background="DarkRed" Foreground="White"
                FontWeight="Bold" FontSize="9"
                BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="6,4">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#8B0000"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <!-- Report & Export Controls Group -->
                        <StackPanel Orientation="Horizontal" Margin="5,15,0,0">
                            <Button Content="📄 Report"
                Click="GenerateProfessionalReport_Click"
                Width="85" Height="25"
                Background="DarkBlue" Foreground="White"
                FontWeight="Bold" BorderThickness="0"
                Cursor="Hand" FontSize="9"
                Margin="2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="5,3">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#000080"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="📊 CSV"
                Click="ExportToCsv_Click"
                Width="70" Height="25"
                Background="DarkGreen" Foreground="White"
                FontWeight="Bold" Margin="2"
                BorderThickness="0" Cursor="Hand" FontSize="9">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="5,3">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#006400"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="btnExportTopPng" 
                Content="📈 Remissions"
                Click="ShowAllTimeRemissions_Click"
                Width="95" Height="25"
                Background="Purple" Foreground="White"
                FontWeight="Bold" BorderThickness="0"
                Cursor="Hand" FontSize="9" Margin="2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="5,3">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#800080"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 4: Collapsible Clinical Metrics -->
                <Border Grid.Row="4" 
        BorderBrush="#2B5F75"
        BorderThickness="2"
        Background="#E6F3FF"
        Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Toggle Header - Always Visible -->
                        <Border Background="#2B5F75" 
                Padding="8,5"
                Cursor="Hand"
                MouseLeftButtonUp="ToggleMetrics_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Toggle Button -->
                                <TextBlock x:Name="MetricsToggleIcon" 
                           Grid.Column="0"
                           Text="▶" 
                           FontSize="12" 
                           Foreground="White"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

                                <!-- Updated Title -->
                                <TextBlock Grid.Column="1"
                           Text="Clinical Outcomes Analysis"
                           FontSize="14" FontWeight="Bold"
                           Foreground="White" 
                           VerticalAlignment="Center"/>

                                <!-- Updated Quick Stats when collapsed -->
                                <StackPanel x:Name="QuickStats" 
                            Grid.Column="2" 
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                                    <TextBlock Text="PHQ-9 Response: " FontSize="10" Foreground="LightGray"/>
                                    <TextBlock x:Name="QuickResponseRate" Text="0.0%" FontSize="10" FontWeight="Bold" Foreground="White" Margin="0,0,15,0"
                               ToolTip="Percentage of patients with ≥50% improvement in PHQ-9 scores"/>
                                    <TextBlock Text="BDI-II Remission: " FontSize="10" Foreground="LightGray"/>
                                    <TextBlock x:Name="QuickRemissionRate" Text="0.0%" FontSize="10" FontWeight="Bold" Foreground="White"
                               ToolTip="Percentage of patients with most recent BDI-II score ≤14"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Expandable Content -->
                        <StackPanel x:Name="MetricsContent" 
                    Visibility="Collapsed"
                    Margin="10">

                            <!-- Main Metrics Grid - Updated with clearer labels -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- PHQ-9 Response Rate -->
                                <Border Grid.Row="0" Grid.Column="0" 
                        Background="White" 
                        BorderBrush="#4682B4" 
                        BorderThickness="2" 
                        Padding="10" 
                        Margin="0,0,5,5"
                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="PHQ-9 Response Rate" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" Foreground="#4682B4"/>
                                        <TextBlock Text="(≥50% improvement)" FontSize="9" 
                                   HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock x:Name="ResponseRateText" Text="0.0%" FontSize="24" FontWeight="Bold"
                                       Foreground="#4682B4" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="ResponseCountText" Text="(0/0)" FontSize="10" Foreground="Gray"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                        </StackPanel>
                                        <TextBlock Text="Based on PHQ-9 scores" 
                                   FontSize="8" Foreground="Gray" 
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- BDI-II Remission Rate -->
                                <Border Grid.Row="0" Grid.Column="1" 
                        Background="White" 
                        BorderBrush="#8B4513" 
                        BorderThickness="2" 
                        Padding="10" 
                        Margin="0,0,5,5"
                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="BDI-II Remission Rate" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" Foreground="#8B4513"/>
                                        <TextBlock Text="(most recent score ≤14)" FontSize="9" 
                                   HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock x:Name="RemissionRateText" Text="0.0%" FontSize="24" FontWeight="Bold"
                                       Foreground="#8B4513" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="RemissionCountText" Text="(0/0)" FontSize="10" Foreground="Gray"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                        </StackPanel>
                                        <TextBlock Text="Based on BDI-II scores" 
                                   FontSize="8" Foreground="Gray" 
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Average PHQ-9 Improvement -->
                                <Border Grid.Row="0" Grid.Column="2" 
                        Background="White" 
                        BorderBrush="#FF8C00" 
                        BorderThickness="2" 
                        Padding="10" 
                        Margin="0,0,5,5"
                        CornerRadius="5">
                                    <StackPanel>
                                        <TextBlock Text="Average PHQ-9 Improvement" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" Foreground="#FF8C00"/>
                                        <TextBlock Text="(baseline to recent)" FontSize="9" 
                                   HorizontalAlignment="Center" Foreground="Gray" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="AverageImprovementText" Text="0.0%" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="#FF8C00"/>
                                        <TextBlock Text="All eligible patients" 
                                   FontSize="8" Foreground="Gray" 
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Control Buttons -->
                                <StackPanel Grid.Row="0" Grid.Column="3" 
                            VerticalAlignment="Center" 
                            Margin="10,0,0,0">
                                    <Button Content="↻ Refresh Outcomes" Click="CalculateMetrics_Click"
                                             ToolTip="Manually refresh clinical outcomes (auto-calculates on patient selection)"
                            Width="120" Height="30" Margin="0,0,0,5"
                            Background="#2B5F75" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand" FontSize="10">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="8">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1E4A5F"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Export Report" Click="ExportMetricsReport_Click"
                            Width="120" Height="30"
                            Background="DarkGreen" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand" FontSize="10">
                                        <Button.Style>
                                            <Style TargetType="Button">
