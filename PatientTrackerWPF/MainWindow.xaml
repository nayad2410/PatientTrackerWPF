        Background="White" 
        BorderBrush="#2B5F75" 
        BorderThickness="1" 
        Padding="15" 
        Margin="0,0,5,5"
        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PHQ-9 Eligible Patients" FontWeight="Bold" FontSize="11"
                       HorizontalAlignment="Center" Foreground="#4682B4" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="PHQ9EligibleText" Text="0" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="#4682B4"/>
                                            <TextBlock Text="≥2 PHQ-9 assessments" FontSize="8" 
                       HorizontalAlignment="Center" Foreground="Gray"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="BDI-II Eligible Patients" FontWeight="Bold" FontSize="11"
                       HorizontalAlignment="Center" Foreground="#8B4513" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="BDI2EligibleText" Text="0" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="#8B4513"/>
                                            <TextBlock Text="≥2 BDI-II assessments" FontSize="8" 
                       HorizontalAlignment="Center" Foreground="Gray"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Total Patients" FontWeight="Bold" FontSize="11"
                       HorizontalAlignment="Center" Foreground="#2B5F75" Margin="0,0,0,5"/>
