<Window x:Class="PatientTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Patient Score Entry" Height="1000" Width="1200">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Patient Selector -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Select Patient:" VerticalAlignment="Center" Margin="0 0 10 0" FontWeight="Bold"/>
            <ComboBox x:Name="PatientSelector" Width="200" SelectionChanged="PatientSelector_SelectionChanged"/>
        </StackPanel>

        <!-- Input Fields -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0 0 0 10">
            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="Patient ID" FontWeight="SemiBold"/>
                <TextBox x:Name="PatientIdBox" Width="100" Height="25"/>
            </StackPanel>
            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="PHQ-9" FontWeight="SemiBold"/>
                <TextBox x:Name="Phq9Box" Width="60" Height="25"/>
            </StackPanel>
            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="GAD-7" FontWeight="SemiBold"/>
                <TextBox x:Name="Gad7Box" Width="60" Height="25"/>
            </StackPanel>
            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="BDI-II" FontWeight="SemiBold"/>
                <TextBox x:Name="Bdi2Box" Width="60" Height="25"/>
            </StackPanel>
            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="PCL-5" FontWeight="SemiBold"/>
                <TextBox x:Name="PCL5Total" Width="60" Height="25"/>
            </StackPanel>
            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="Y-BOCS" FontWeight="SemiBold"/>
                <TextBox x:Name="YBOCS" Width="60" Height="25"/>
            </StackPanel>
            <StackPanel Margin="0 0 15 0">
                <TextBlock Text="Date" FontWeight="SemiBold"/>
                <DatePicker x:Name="DatePicker" SelectedDate="{x:Static sys:DateTime.Now}" Width="120" Height="25"/>
            </StackPanel>
            <Button Content="Add Score" Click="AddScore_Click" Margin="10 20 0 0" Height="30" Width="80" Background="LightBlue"/>
        </StackPanel>

        <!-- Note Box -->
        <StackPanel Grid.Row="2" Margin="0 0 0 10">
            <TextBlock Text="Treatment Notes" FontWeight="SemiBold" Margin="0 0 0 5"/>
            <TextBox x:Name="NoteBox" Width="800" Height="60" TextWrapping="Wrap" 
                     HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- Chart -->
        <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1" Margin="0 10" Padding="10">
            <StackPanel>
                <lvc:CartesianChart x:Name="PatientProgressChart"
                                    Series="{Binding ScoreSeriesCollection}"
                                    Background="White"
                                    Height="300">
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="Score" MinValue="0" MaxValue="80" FontSize="12">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="10" IsEnabled="True"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>

                <!-- Chart Legend -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                    <!-- PHQ-9 -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 20 0">
                        <Rectangle Width="20" Height="3" Fill="MediumBlue" VerticalAlignment="Center"/>
                        <TextBlock Text="PHQ-9" Margin="5 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- GAD-7 -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 20 0">
                        <Rectangle Width="20" Height="3" Fill="ForestGreen" VerticalAlignment="Center"/>
                        <TextBlock Text="GAD-7" Margin="5 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- BDI-II -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 20 0">
                        <Rectangle Width="20" Height="3" Fill="OrangeRed" VerticalAlignment="Center"/>
                        <TextBlock Text="BDI-II" Margin="5 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- PCL-5 -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 20 0">
                        <Rectangle Width="20" Height="3" Fill="DarkCyan" VerticalAlignment="Center"/>
                        <TextBlock Text="PCL-5" Margin="5 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Y-BOCS -->
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="20" Height="3" Fill="Purple" VerticalAlignment="Center"/>
                        <TextBlock Text="Y-BOCS" Margin="5 0 0 0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Filter + Export -->
        <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0 10">
            <TextBlock Text="Filter by Patient ID:" VerticalAlignment="Center" Margin="0 0 10 0" FontWeight="SemiBold"/>
            <TextBox x:Name="FilterBox" Width="150" Height="25" Margin="0 0 10 0" TextChanged="FilterBox_TextChanged"/>
            <Button Content="Export to CSV" Click="ExportToCsv_Click" Height="30" Width="100" Background="LightGreen" Margin="0 0 10 0"/>
            <Button Content="Export to PNG" Click="ExportToPng_Click" Height="30" Width="100" Background="LightCoral"/>
        </StackPanel>

        <!-- Clinical Metrics Section -->
        <Border Grid.Row="5" BorderBrush="DarkBlue" BorderThickness="2" Margin="0 10" Padding="15" Background="LightBlue">
            <StackPanel>
                <TextBlock Text="BDI-II Clinical Outcomes" FontSize="16" FontWeight="Bold" Margin="0 0 0 10" HorizontalAlignment="Center"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Response Rate -->
                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Response Rate" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="(≥50% improvement)" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                        <TextBlock x:Name="ResponseRateText" Text="0.0%" FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="Green"/>
                        <TextBlock x:Name="ResponseCountText" Text="(0/0 patients)" FontSize="10" 
                                   HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <!-- Remission Rate -->
                    <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="Remission Rate" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="(score &lt;14)" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                        <TextBlock x:Name="RemissionRateText" Text="0.0%" FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="Blue"/>
                        <TextBlock x:Name="RemissionCountText" Text="(0/0 patients)" FontSize="10" 
                                   HorizontalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <!-- Average Improvement -->
                    <StackPanel Grid.Column="2" Margin="0 0 10 0">
                        <TextBlock Text="Average Improvement" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="(all patients)" FontSize="10" HorizontalAlignment="Center" Foreground="Gray"/>
                        <TextBlock x:Name="AverageImprovementText" Text="0.0%" FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="Orange"/>
                    </StackPanel>

                    <!-- Eligible Patients -->
                    <StackPanel Grid.Column="3" Margin="0 0 10 0">
                        <TextBlock Text="Eligible Patients" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="(baseline ≥14, 2+ assessments)" FontSize="9" HorizontalAlignment="Center" Foreground="Gray"/>
                        <TextBlock x:Name="EligiblePatientsText" Text="0" FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Foreground="Purple"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Vertical">
                        <Button x:Name="CalculateMetricsBtn" Content="Calculate Metrics" 
                                Click="CalculateMetrics_Click" Margin="0 0 0 5" Height="30" Width="120" 
                                Background="DarkBlue" Foreground="White" FontWeight="Bold"/>
                        <Button x:Name="ExportMetricsBtn" Content="Export Report" 
                                Click="ExportMetricsReport_Click" Height="30" Width="120" 
                                Background="DarkGreen" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <!-- Current Patient Outcome -->
                <Border BorderBrush="Gray" BorderThickness="1" Margin="0 10 0 0" Padding="10" Background="White">
                    <StackPanel x:Name="CurrentPatientOutcome" Visibility="Collapsed">
                        <TextBlock x:Name="CurrentPatientOutcomeTitle" Text="" FontWeight="Bold" Margin="0 0 0 5"/>
                        <TextBlock x:Name="CurrentPatientOutcomeDetails" Text="" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <DataGrid x:Name="ScoresGrid"
                  Grid.Row="6"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  AlternatingRowBackground="LightGray"
                  FontSize="11">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" Width="100"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                <DataGridTextColumn Header="PHQ-9" Binding="{Binding PHQ9}" Width="60"/>
                <DataGridTextColumn Header="GAD-7" Binding="{Binding GAD7}" Width="60"/>
                <DataGridTextColumn Header="BDI-II" Binding="{Binding BDI2}" Width="60"/>
                <DataGridTextColumn Header="PCL-5" Binding="{Binding PCL5}" Width="60"/>
                <DataGridTextColumn Header="Y-BOCS" Binding="{Binding YBOCS}" Width="70"/>
                <DataGridTemplateColumn Header="Notes" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Padding="5" MaxWidth="400"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Export Layout (Hidden) -->
        <Grid x:Name="ExportLayout" Visibility="Collapsed" Background="White" Width="1600" Height="1200">
            <Border Padding="30" Background="White">
                <StackPanel Orientation="Vertical">

                    <!-- Header -->
                    <TextBlock Text="Patient Progress Report" FontSize="24" FontWeight="Bold" Margin="0 0 0 15" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ExportPatientId" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0 0 0 5"/>
                    <TextBlock x:Name="ExportDate" FontSize="12" HorizontalAlignment="Center" Margin="0 0 0 20"/>

                    <!-- Chart -->
                    <TextBlock Text="Progress Chart" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0 0 0 20">
                        <Image x:Name="ExportChartImage"
                               Height="250"
                               Width="1500"
                               HorizontalAlignment="Center"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Data Table -->
                    <TextBlock Text="Score History" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="0 0 0 20" MaxHeight="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <DataGrid x:Name="ExportScoreGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserResizeRows="False"
                                      FontSize="11"
                                      ColumnHeaderHeight="25"
                                      GridLinesVisibility="All"
                                      Background="White"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Width="80"/>
                                    <DataGridTextColumn Header="PHQ-9" Binding="{Binding PHQ9}" Width="50"/>
                                    <DataGridTextColumn Header="GAD-7" Binding="{Binding GAD7}" Width="50"/>
                                    <DataGridTextColumn Header="BDI-II" Binding="{Binding BDI2}" Width="50"/>
                                    <DataGridTextColumn Header="PCL-5" Binding="{Binding PCL5}" Width="50"/>
                                    <DataGridTextColumn Header="Y-BOCS" Binding="{Binding YBOCS}" Width="60"/>
                                    <DataGridTemplateColumn Header="Notes" Width="400">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Padding="3" MaxWidth="390" FontSize="10"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>
                    </Border>

                    <!-- Notes Summary -->
                    <TextBlock Text="Treatment Notes Summary" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="15" Margin="0 0 0 10" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ExportNoteText"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Width="1520"
                                       LineHeight="16"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>