                                            Hoverable="True"
                                         DataTooltip="{StaticResource MyTooltip}"
                                         Background="White"/>

                        <!-- Canvas for Note Overlays - Much more room now -->
                        <Canvas x:Name="ChartNotesCanvas"
                            Panel.ZIndex="10"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            ClipToBounds="False">

                            <!-- Note Box 1 -->
