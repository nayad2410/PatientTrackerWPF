                                            <TextBlock x:Name="TotalEligibleText" Text="0" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="#2B5F75"/>
                                            <TextBlock Text="With multiple assessments" FontSize="8" 
                       HorizontalAlignment="Center" Foreground="Gray"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
            
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
        Background="#F0F8FF" BorderBrush="#2B5F75" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,5,0,10">
                                    <StackPanel>
                                        <TextBlock Text="CLINICAL OUTCOME DEFINITIONS" FontWeight="Bold" FontSize="12" Foreground="#2B5F75" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="• PHQ-9 Response:" FontWeight="Bold" FontSize="10" Foreground="#4682B4"/>
                                                <TextBlock Text="  ≥50% improvement in PHQ-9 score from baseline to most recent assessment" 
                           FontSize="10" Margin="0,0,0,5" TextWrapping="Wrap"/>

                                                <TextBlock Text="• Average Improvement:" FontWeight="Bold" FontSize="10" Foreground="#FF8C00"/>
                                                <TextBlock Text="  Mean percentage improvement across all patients with PHQ-9 data" 
                           FontSize="10" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="• BDI-II Remission:" FontWeight="Bold" FontSize="10" Foreground="#8B4513"/>
                                                <TextBlock Text="  Most recent BDI-II score ≤14 (regardless of improvement percentage)" 
                           FontSize="10" Margin="0,0,0,5" TextWrapping="Wrap"/>

                                                <TextBlock Text="• Eligibility:" FontWeight="Bold" FontSize="10" Foreground="#2B5F75"/>
                                                <TextBlock Text="  Patients need ≥2 assessments for the respective measurement scale" 
                           FontSize="10" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Current Patient Outcome Section - Enhanced -->
                            <Border BorderBrush="#2B5F75"
                    BorderThickness="2"
                    Background="White"
                    Padding="15"
                    CornerRadius="5">
                                <StackPanel x:Name="CurrentPatientOutcome">
                                    <TextBlock Text="Selected Patient Analysis" 
                               FontWeight="Bold" FontSize="14"
                               Foreground="#2B5F75"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock x:Name="CurrentPatientOutcomeTitle"
                                       Text="No patient selected"
