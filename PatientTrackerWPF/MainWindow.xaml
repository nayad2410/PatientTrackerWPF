<Window x:Class="PatientTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Patient Score Entry" Height="700" Width="950">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Patient Selector -->
            <RowDefinition Height="Auto"/>
            <!-- Input Fields -->
            <RowDefinition Height="200"/>
            <!-- Chart -->
            <RowDefinition Height="Auto"/>
            <!-- Filter + Export -->
            <RowDefinition Height="*"/>
            <!-- Data Grid -->
        </Grid.RowDefinitions>

        <!-- Patient Selector -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 10">
            <TextBlock Text="Select Patient:" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <ComboBox x:Name="PatientSelector" Width="150" SelectionChanged="PatientSelector_SelectionChanged"/>
        </StackPanel>

        <!-- Input Fields -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0 0 0 10">
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="Patient ID"/>
                <TextBox x:Name="PatientIdBox" Width="100"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="PHQ-9"/>
                <TextBox x:Name="Phq9Box" Width="60"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="GAD-7"/>
                <TextBox x:Name="Gad7Box" Width="60"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="BDI-II"/>
                <TextBox x:Name="Bdi2Box" Width="60"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="PCL-5"/>
                <TextBox x:Name="PCL5Total" Width="60"/>
            </StackPanel>
            <StackPanel Margin="0 0 20 0">
                <TextBlock Text="YBOCS"/>
                <TextBox x:Name="YBOCS" Width="60"/>
            </StackPanel>
            <Button Content="Add Score" Click="AddScore_Click" Margin="10 0"/>
        </StackPanel>

        <!-- Chart -->
        <lvc:CartesianChart Grid.Row="2" Name="progressChart" Series="{Binding ScoreSeriesCollection}">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="Time Point" Labels="{Binding TimeLabels}">
                    <lvc:Axis.Separator>
                        <lvc:Separator Step="1" />
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="Score" MinValue="0" MaxValue="30"/>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

        <!-- Filter + Export -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0 10">
            <TextBlock Text="Filter by Patient ID:" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <TextBox x:Name="FilterBox" Width="100" Margin="0 0 10 0" TextChanged="FilterBox_TextChanged"/>
            <Button Content="Export to CSV" Click="ExportToCsv_Click"/>
        </StackPanel>

        <!-- Data Grid -->
        <DataGrid x:Name="ScoresGrid" Grid.Row="4" AutoGenerateColumns="True"/>
    </Grid>
</Window>
